# notes-app environment template
#
# Copy to `.env` (gitignored) and fill in real values. Add a corresponding
# variable here whenever a new env is introduced — never commit real values.
# CI consumes secrets from GitHub Encrypted Secrets and Vercel/Supabase project
# config, not from this file.

# --- App ---
# 'development' | 'staging' | 'production' — drives Sentry environment tags.
APP_ENV=development

# --- Supabase (M02 Auth, M04 Notes, M05 Sync) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Client-side: same URL/anon key but exposed to the Next.js browser bundle.
# M13 web shell reads these from `process.env.NEXT_PUBLIC_*`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project reference (e.g. abcd1234) for `supabase link` / `db push`.
SUPABASE_PROJECT_REF=
# Personal access token for the Supabase CLI in CI (db-migrate.yml).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Google (M02 Google sign-in, M03 Drive storage, M08 Calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ollama (M09 AI Services) ---
# Tailscale Funnel URL of the home box; see runbook §AI.
OLLAMA_ENDPOINT_URL=
# Same URL exposed to the web client so the "Use default endpoint"
# button on /settings/ai/endpoint can one-click-fill it (BUG-005).
NEXT_PUBLIC_OLLAMA_ENDPOINT_URL=

# --- Sentry (M14 Observability) ---
SENTRY_DSN_WEB=
SENTRY_DSN_ANDROID=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_PROJECT_ANDROID=

# --- PostHog (M14 Observability) ---
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Set to 'true' to disable analytics at the env level (e.g. for tests).
ANALYTICS_OPTOUT=false

# --- Vercel (M14 web deploy) ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Android release (M14 build-apk) ---
# Base64-encoded keystore file content (CI decodes to release.keystore).
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
# Google Play service-account JSON (one-line escaped) used by upload-google-play.
PLAY_SERVICE_ACCOUNT_JSON=

# --- Anthropic (build-time AI dev assistance; not used at runtime in V1) ---
ANTHROPIC_API_KEY=
