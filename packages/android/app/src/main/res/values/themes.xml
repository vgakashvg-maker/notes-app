<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash + Activity theme. The Compose layer paints over this once
         setContent runs; the splash theme is only visible for the brief
         cold-start window. -->
    <style name="Theme.Notes.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
