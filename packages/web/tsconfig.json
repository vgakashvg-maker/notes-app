{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "allowJs": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "vitest-env.d.ts",
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "src/**/*",
    "middleware.ts",
    "instrumentation.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
